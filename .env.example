# ══════════════════════════════════════════════════════════
# LLM Provider Configuration (MiniMax / OpenRouter / Groq / OpenAI)
# ══════════════════════════════════════════════════════════
# At least ONE of LLM_API_KEY or OPENAI_API_KEY must be set.
# LLM_API_KEY is tried first; OPENAI_API_KEY is the fallback.

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=minimax/minimax-01
LLM_API_KEY=sk-or-v1-your-openrouter-key-here

# Legacy / direct OpenAI fallback (used only if LLM_API_KEY is unset)
# OPENAI_API_KEY=sk-your-openai-key-here

# ══════════════════════════════════════════════════════════
# Razorpay Test Credentials
# ══════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=rzp_test_DUMMY_KEY_ID
RAZORPAY_KEY_SECRET=DUMMY_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret_key

# ══════════════════════════════════════════════════════════
# Application Configuration
# ══════════════════════════════════════════════════════════
DATABASE_PATH=revenue_recovery.db

# CORS: comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8010,http://127.0.0.1:8010,http://localhost:3000

# ══════════════════════════════════════════════════════════
# Merchant & Recovery Defaults
# ══════════════════════════════════════════════════════════
# DEMO_VPA is used for UPI intent URIs when MERCHANT_UPI_VPA is unset
DEMO_VPA=revive@upi
MERCHANT_UPI_VPA=gnileshpta56@okicici
MERCHANT_NAME=Merchant
RECOVERY_CUSTOMER_CONTACT=9876543210
RECOVERY_CUSTOMER_EMAIL=recover@test.com

# ══════════════════════════════════════════════════════════
# Voice Engine (Sarvam AI Indic TTS + gTTS Fallback)
# ══════════════════════════════════════════════════════════
# When unset or unreachable, automatically fails over to local gTTS with zero downtime
SARVAM_API_KEY=your-sarvam-api-key-here

# ══════════════════════════════════════════════════════════
# Long-Term Memory (Cognee Knowledge Graph + SQLite WAL Fallback)
# ══════════════════════════════════════════════════════════
# When unset or unreachable, automatically fails over to SQLite state history
COGNEE_API_KEY=your-cognee-api-key-here

# ══════════════════════════════════════════════════════════
# n8n Autonomous Workflow Execution Layer
# ══════════════════════════════════════════════════════════
# Webhook URL for n8n execution layer (optional; fails over to internal Python sweeps)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/promise-to-pay-trigger
FASTAPI_BASE_URL=http://localhost:8010

# ══════════════════════════════════════════════════════════
# Security & Simulation Gating
# ══════════════════════════════════════════════════════════
# Set to 'false' in production to disable all /simulate-* endpoints and reset-demo
DEMO_MODE=true
PORT=8010
MAX_DISCOUNT_PERCENTAGE=10.0



