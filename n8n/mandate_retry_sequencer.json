{
  "name": "Mandate Retry Sequencer",
  "active": true,
  "versionId": "f7d54b20-1a2b-4c3d-8e5f-222222222222",
  "settings": { "executionOrder": "v1", "timezone": "Asia/Kolkata" },
  "nodes": [
    {
      "parameters": {
        "content": "## Mandate Retry Sequencer\n3 RBI-spaced attempts, HARD CAP — a 4th attempt node does not exist.\nT+1 10:30 IST → T+2 10:30 IST → 1st of next month 10:30 IST.\nRecovery mid-sequence → backend auto-cancels remaining (MANDATE_CANCELLED).",
        "height": 320, "width": 400
      },
      "id": "sticky-m", "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote", "typeVersion": 1,
      "position": [-480, -100]
    },
    {
      "parameters": { "httpMethod": "POST", "path": "mandate-retry", "responseMode": "onReceived", "options": {} },
      "id": "wh-m", "name": "Mandate Failure Dispatched",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2,
      "position": [-400, 200], "webhookId": "mandate-retry"
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "b1", "name": "api_base", "type": "string", "value": "http://localhost:8010" },
          { "id": "b2", "name": "payment_id", "type": "string", "value": "={{ $json.body.payment_id }}" },
          { "id": "b3", "name": "correlation_id", "type": "string", "value": "={{ $json.body.correlation_id }}" }
        ]},
        "options": {}
      },
      "id": "set-m", "name": "Init Context",
      "type": "n8n-nodes-base.set", "typeVersion": 3.4,
      "position": [-180, 200]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $now.setZone('Asia/Kolkata').plus({ days: 1 }).set({ hour: 10, minute: 30, second: 0, millisecond: 0 }).toISO() }}",
        "timezone": "Asia/Kolkata", "options": {}
      },
      "id": "wait-m1", "name": "Until Tomorrow 10:30 IST",
      "type": "n8n-nodes-base.wait", "typeVersion": 1.1,
      "position": [40, 200], "webhookId": "auto-wait-m1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Init Context').item.json.api_base }}/api/mandates/attempt",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payment_id: $('Init Context').item.json.payment_id, correlation_id: $('Init Context').item.json.correlation_id, attempt_no: 1 }) }}",
        "options": { "timeout": 5000 }
      },
      "id": "http-m1", "name": "Mandate Attempt 1",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [260, 200],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Init Context').item.json.api_base }}/api/payment/{{ $('Init Context').item.json.payment_id }}/status",
        "options": { "timeout": 5000 }
      },
      "id": "chk-m1", "name": "Check Status #1",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [460, 200],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "m1", "leftValue": "={{ $json.status }}", "rightValue": "RECOVERED",
              "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-m1", "name": "Recovered after Attempt 1?",
      "type": "n8n-nodes-base.if", "typeVersion": 2.2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $now.setZone('Asia/Kolkata').plus({ days: 2 }).set({ hour: 10, minute: 30, second: 0, millisecond: 0 }).toISO() }}",
        "timezone": "Asia/Kolkata", "options": {}
      },
      "id": "wait-m2", "name": "Until Day-After 10:30 IST",
      "type": "n8n-nodes-base.wait", "typeVersion": 1.1,
      "position": [880, 300], "webhookId": "auto-wait-m2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Init Context').item.json.api_base }}/api/mandates/attempt",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payment_id: $('Init Context').item.json.payment_id, correlation_id: $('Init Context').item.json.correlation_id, attempt_no: 2 }) }}",
        "options": { "timeout": 5000 }
      },
      "id": "http-m2", "name": "Mandate Attempt 2",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [1100, 300],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Init Context').item.json.api_base }}/api/payment/{{ $('Init Context').item.json.payment_id }}/status",
        "options": { "timeout": 5000 }
      },
      "id": "chk-m2", "name": "Check Status #2",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [1300, 300],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "m2", "leftValue": "={{ $json.status }}", "rightValue": "RECOVERED",
              "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-m2", "name": "Recovered after Attempt 2?",
      "type": "n8n-nodes-base.if", "typeVersion": 2.2,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $now.setZone('Asia/Kolkata').plus({ months: 1 }).set({ day: 1, hour: 10, minute: 30, second: 0, millisecond: 0 }).toISO() }}",
        "timezone": "Asia/Kolkata", "options": {}
      },
      "id": "wait-m3", "name": "Until 1st of Next Month 10:30 IST",
      "type": "n8n-nodes-base.wait", "typeVersion": 1.1,
      "position": [1720, 400], "webhookId": "auto-wait-m3"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Init Context').item.json.api_base }}/api/mandates/attempt",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payment_id: $('Init Context').item.json.payment_id, correlation_id: $('Init Context').item.json.correlation_id, attempt_no: 3 }) }}",
        "options": { "timeout": 5000 }
      },
      "id": "http-m3", "name": "Mandate Attempt 3 (FINAL)",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [1940, 400],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Init Context').item.json.api_base }}/api/payment/{{ $('Init Context').item.json.payment_id }}/status",
        "options": { "timeout": 5000 }
      },
      "id": "chk-m3", "name": "Check Status #3",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [2140, 400],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "m3", "leftValue": "={{ $json.status }}", "rightValue": "RECOVERED",
              "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-m3", "name": "Recovered after Attempt 3?",
      "type": "n8n-nodes-base.if", "typeVersion": 2.2,
      "position": [2340, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Init Context').item.json.api_base }}/api/escalate-human",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payment_id: $('Init Context').item.json.payment_id, correlation_id: $('Init Context').item.json.correlation_id, reason: 'mandate_attempts_exhausted' }) }}",
        "options": { "timeout": 5000 }
      },
      "id": "http-mesc", "name": "Escalate: Attempts Exhausted",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [2580, 520],
      "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000
    },
    {
      "parameters": {},
      "id": "noop-mend", "name": "Sequencer Resolved",
      "type": "n8n-nodes-base.noOp", "typeVersion": 1,
      "position": [2820, 300]
    }
  ],
  "connections": {
    "Mandate Failure Dispatched": { "main": [[{ "node": "Init Context", "type": "main", "index": 0 }]] },
    "Init Context": { "main": [[{ "node": "Until Tomorrow 10:30 IST", "type": "main", "index": 0 }]] },
    "Until Tomorrow 10:30 IST": { "main": [[{ "node": "Mandate Attempt 1", "type": "main", "index": 0 }]] },
    "Mandate Attempt 1": { "main": [[{ "node": "Check Status #1", "type": "main", "index": 0 }]] },
    "Check Status #1": { "main": [[{ "node": "Recovered after Attempt 1?", "type": "main", "index": 0 }]] },
    "Recovered after Attempt 1?": {
      "main": [
        [{ "node": "Sequencer Resolved", "type": "main", "index": 0 }],
        [{ "node": "Until Day-After 10:30 IST", "type": "main", "index": 0 }]
      ]
    },
    "Until Day-After 10:30 IST": { "main": [[{ "node": "Mandate Attempt 2", "type": "main", "index": 0 }]] },
    "Mandate Attempt 2": { "main": [[{ "node": "Check Status #2", "type": "main", "index": 0 }]] },
    "Check Status #2": { "main": [[{ "node": "Recovered after Attempt 2?", "type": "main", "index": 0 }]] },
    "Recovered after Attempt 2?": {
      "main": [
        [{ "node": "Sequencer Resolved", "type": "main", "index": 0 }],
        [{ "node": "Until 1st of Next Month 10:30 IST", "type": "main", "index": 0 }]
      ]
    },
    "Until 1st of Next Month 10:30 IST": { "main": [[{ "node": "Mandate Attempt 3 (FINAL)", "type": "main", "index": 0 }]] },
    "Mandate Attempt 3 (FINAL)": { "main": [[{ "node": "Check Status #3", "type": "main", "index": 0 }]] },
    "Check Status #3": { "main": [[{ "node": "Recovered after Attempt 3?", "type": "main", "index": 0 }]] },
    "Recovered after Attempt 3?": {
      "main": [
        [{ "node": "Sequencer Resolved", "type": "main", "index": 0 }],
        [{ "node": "Escalate: Attempts Exhausted", "type": "main", "index": 0 }]
      ]
    },
    "Escalate: Attempts Exhausted": { "main": [[{ "node": "Sequencer Resolved", "type": "main", "index": 0 }]] }
  }
}
